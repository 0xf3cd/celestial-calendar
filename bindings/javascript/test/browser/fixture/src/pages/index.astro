<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Celestial package smoke</title>
  </head>
  <body>
    <main>
      <h1>Celestial package smoke</h1>
      <output id="date-result">waiting</output>
      <output id="result">waiting</output>
    </main>
    <script>
      import * as celestial from "@0xf3cd/celestial";
      import { dateToCivilAtOffset, civilAtOffsetToDate } from "@0xf3cd/celestial/date";

      const output = document.querySelector("#result");
      const civil = dateToCivilAtOffset(new Date("2024-02-03T16:00:00.000Z"), 480);
      const dateResult = {
        civil,
        iso: civilAtOffsetToDate(civil, 480).toISOString(),
      };
      document.querySelector("#date-result").textContent = JSON.stringify(dateResult);
      window.__CELESTIAL_IMPORTED__ = true;
      window.__START_CELESTIAL__ = async () => {
        try {
          await celestial.init();
          let translated = false;
          try {
            celestial.lunar.fromGregorian("algo1", { year: 1900, month: 1, day: 1 });
          } catch (error) {
            translated = error instanceof celestial.CelestialError
              && error.operation === "lunar.fromGregorian"
              && error.recorded
              && error.message.includes("cannot be represented");
          }
          const lichun = celestial.jieqi.moment(2024, celestial.Jieqi.LICHUN);
          window.__CELESTIAL_RESULT__ = {
            translated,
            survived: celestial.jieqi.name(celestial.Jieqi.LICHUN) === "立春",
            lichun,
            lichunMatches: lichun.jieqi === celestial.Jieqi.LICHUN,
            jdUt1: celestial.time.ut1ToJd(lichun.momentUt1),
          };
        } catch (error) {
          window.__CELESTIAL_RESULT__ = { fatal: String(error?.stack || error) };
        }
        output.textContent = JSON.stringify(window.__CELESTIAL_RESULT__);
      };
    </script>
  </body>
</html>
